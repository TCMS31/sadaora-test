# Used by docker-compose.yml. Copy to .env before `docker compose up`.

# Database credentials (compose creates the database with these).
POSTGRES_USER=sadaora
POSTGRES_PASSWORD=sadaora
POSTGRES_DB=sadaora

# Required — compose refuses to start without it.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Host ports.
API_PORT=3001
WEB_PORT=8080

# Baked into the frontend bundle at build time, and allowed by the API's CORS.
VITE_API_URL=http://localhost:3001/api
CORS_ORIGIN=http://localhost:8080
