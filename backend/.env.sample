# --- Database -----------------------------------------------------------
# Required when DATA_DRIVER=prisma (the default).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sadaora"

# --- Auth ---------------------------------------------------------------
# Required in production. Generate one with: openssl rand -base64 48
JWT_SECRET="change-me-before-deploying"
JWT_EXPIRES_IN="7d"

# --- Server -------------------------------------------------------------
PORT=3001
NODE_ENV=development
# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN="http://localhost:5173"

# --- Storage ------------------------------------------------------------
# "prisma" talks to PostgreSQL. "memory" runs the same API against an
# in-process store with no database — used by the tests and the demo server.
DATA_DRIVER=prisma
UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES=2097152

# --- Tuning -------------------------------------------------------------
FEED_PAGE_SIZE=5
MAX_FEED_PAGE_SIZE=50
BCRYPT_ROUNDS=10
